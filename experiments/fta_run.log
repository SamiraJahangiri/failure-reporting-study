{"data": {"change": "Reporting-policy rate axis zoomed using 1.25 times largest upper CI, rounded up to .01; percent tick labels; intervention pp/% units; predetermined probe marked Fixed.", "figure_reproduction": "Run this code with the logged SAE-1 Python environment in the existing ICPRAM directory; no GPU or model loading is needed.", "font": "DejaVu Serif", "measurement_changes": false, "reproduction_python": "import csv, json, math\nfrom pathlib import Path\nimport fta_experiment as fta\nimport matplotlib\nmatplotlib.use(\"Agg\")\nfrom matplotlib.figure import Figure\nfrom matplotlib.ticker import FuncFormatter, PercentFormatter\ncsv.field_size_limit(10000000)\nsummaries = []\nwith open(\"fta_results.csv\", newline=\"\") as handle:\n    for record in csv.DictReader(handle):\n        if record[\"record_type\"] == \"summary\" and record[\"key\"].endswith(\"|final\"):\n            summaries.append(json.loads(record[\"payload\"]))\noriginal_save = Figure.savefig\ndef readable_save(fig, *args, **kwargs):\n    for index, summary in enumerate(summaries):\n        rate, probe, mismatch, effect = fig.axes[index*4:index*4+4]\n        high = max(summary[\"policies\"][policy][\"ci\"][metric][1]\n                   for policy in (\"baseline\", \"transparency\", \"evidence_contract\")\n                   for metric in (\"false_success\", \"false_failure_supported\"))\n        upper = min(1.03, max(.05, math.ceil(high*1.25/.01)*.01))\n        rate.set_ylim(-upper*.05, upper)\n        rate.yaxis.set_major_formatter(PercentFormatter(xmax=1, decimals=0))\n        handles, labels = probe.get_legend_handles_labels()\n        probe.legend(handles, [label.replace(\"Selected B\", \"Fixed B\") for label in labels],\n                     frameon=False, fontsize=8)\n        effect.yaxis.set_major_formatter(FuncFormatter(lambda value, position: f\"{100*value:.1f}\"))\n        effect.set_ylabel(\"Accuracy change (pp) / S,R damage (%)\")\n    return original_save(fig, *args, **kwargs)\nFigure.savefig = readable_save\ntry:\n    info = fta.fta_render_final(summaries, Path(\"fta_summary.png\"))\nfinally:\n    Figure.savefig = original_save\n", "source_script_unchanged": true}, "event": "final_figure_display_revision", "utc": "2026-10-09T23:23:53.941492+00:00"}
