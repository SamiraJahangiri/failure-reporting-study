  "rendering_source": "\"\"\"Render the already-saved combined-error rows; no analysis or scoring.\"\"\"\nimport csv\nimport hashlib\nimport json\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\nfrom matplotlib.ticker import MaxNLocator, MultipleLocator\n\nROOT=Path('/Users/samirajahangiri/failure-reporting-study')\nSOURCE=ROOT/'results/internal_states.csv'\nOUTPUT=ROOT/'results/internal_states_combined.png'\nPROVENANCE=OUTPUT.with_suffix('.json')\nsha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()\npreserved={p:sha(p) for p in [SOURCE,ROOT/'results/internal_states.png',ROOT/'results/internal_states.json',ROOT/'results/answers.jsonl',ROOT/'results/labels.jsonl']}\nif OUTPUT.exists() or PROVENANCE.exists():\n    previous=json.loads(PROVENANCE.read_text())\n    assert sha(OUTPUT)==previous['output']['sha256'], 'Existing rendering changed outside its saved record'\n    assert sha(SOURCE)==previous['source_csv_sha256'], 'Saved numerical source changed'\nwith SOURCE.open(newline='') as f:\n    rows=list(csv.DictReader(f))\nmodels=[('Qwen/Qwen3-8B','Qwen',36),('google/gemma-2-9b-it','Gemma',42),('mistralai/Ministral-3-8B-Instruct-2512','Ministral',34)]\npairs=[('baseline','evidence_contract','Baseline → evidence contract'),('baseline','transparency','Baseline → transparency')]\npanels=[]\nwith plt.rc_context({'font.family':'DejaVu Sans','font.size':11,'axes.spines.top':False,'axes.spines.right':False}):\n    fig,axes=plt.subplots(3,2,figsize=(8.2,6.9),sharex='row',sharey='row')\n    fig.subplots_adjust(left=.19,right=.985,bottom=.105,top=.875,hspace=.28,wspace=.12)\n    for i,(model,name,blocks) in enumerate(models):\n        for j,(source,target,title) in enumerate(pairs):\n            selected=sorted((r for r in rows if r['model']==model and r['metric']=='either' and r['source_policy']==source and r['target_policy']==target),key=lambda r:int(r['decoder_block']))\n            assert [int(r['decoder_block']) for r in selected]==list(range(1,blocks+1))\n            x=[int(r['decoder_block']) for r in selected]\n            y=[float(r['contrast']) for r in selected]\n            low=[float(r['ci_low']) for r in selected]\n            high=[float(r['ci_high']) for r in selected]\n            ax=axes[i,j]\n            ax.fill_between(x,low,high,color='#7555a2',alpha=.16,linewidth=0)\n            ax.plot(x,y,color='#7555a2',linewidth=1.8)\n            ax.axhline(0,color='#87919a',linewidth=.8,zorder=0)\n            ax.set_xlim(0,blocks)\n            ax.xaxis.set_major_locator(MultipleLocator(10))\n            ax.yaxis.set_major_locator(MaxNLocator(nbins=4))\n            ax.tick_params(axis='both',labelsize=10,length=3)\n            if j:\n                ax.tick_params(axis='y',left=False,labelleft=False)\n                ax.spines['left'].set_visible(False)\n            if i==0:\n                ax.set_title(title,fontsize=13,pad=10)\n            panels.append({'model':model,'source_policy':source,'target_policy':target,'metric':'either','blocks':blocks,\n                **{k:int(selected[0][k]) for k in ['matched_case_n','matched_unique_control_n','unmatched_case_n','disappeared_n','excluded_n']},\n                'rows':[{'block':b,'contrast':v,'ci_low':l,'ci_high':h} for b,v,l,h in zip(x,y,low,high)]})\n        position=axes[i,0].get_position()\n        fig.text(.095,(position.y0+position.y1)/2,name,ha='center',va='center',fontsize=12)\n    fig.suptitle('Any unsupported claim',fontsize=16,y=.985)\n    fig.supxlabel('Transformer block',fontsize=13,y=.025)\n    fig.supylabel('Movement − control',fontsize=13,x=.015)\n    fig.savefig(OUTPUT,dpi=220,facecolor='white')\n    plt.close(fig)\nfor path,expected in preserved.items():\n    assert sha(path)==expected,path\nmetadata={'purpose':'Requested minimal re-render of existing combined-error results only','created_at':datetime.now(timezone.utc).isoformat(),\n    'source_csv':str(SOURCE.relative_to(ROOT)),'source_csv_sha256':preserved[SOURCE],\n    'original_figure_preserved':True,'original_figure_sha256':preserved[ROOT/'results/internal_states.png'],\n    'combined_metric':'OR(false_success, fabricated_details), with both labels resolved at both endpoints; not an average of the old curves',\n    'cases':'Any of the two unsupported-claim flags initially true, both false afterward; exact category × pressure matching to controls clean under both policies',\n    'y_axis':'Saved matched mean cosine-distance contrast: case policy-change distance minus case-weighted same-cell control distance',\n    'shading':'Original saved descriptive 95% within-cell bootstrap intervals, unchanged; not recalculated',\n    'scope':'Includes only the two measured unsupported-claim flags, not every possible mistake. Cohorts differ across models and policy pairs.',\n    'new_model_forwards':0,'new_answers':0,'new_scoring':0,'new_bootstrap':0,\n    'panels':panels,'output':{'path':str(OUTPUT.relative_to(ROOT)),'sha256':sha(OUTPUT),'bytes':OUTPUT.stat().st_size},\n    'rendering_source':Path(__file__).read_text()}\nPROVENANCE.write_text(json.dumps(metadata,indent=2,ensure_ascii=False)+'\\n')\nprint(json.dumps({'figure':str(OUTPUT),'bytes':OUTPUT.stat().st_size,'panels':[{k:p[k] for k in ['model','target_policy','matched_case_n','matched_unique_control_n']} for p in panels],'old_files_unchanged':True}))\n"
}
